{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio pessoal de Pedro Braga de Lima — HTML, CSS e JavaScript puro, sem etapa de build.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "serve": "node scripts/serve-site.mjs --port 3000",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write . && npm run stamp",
    "format:check": "prettier --check .",
    "validate:html": "html-validate \"*.html\" \"projetos/*.html\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "stamp:check": "node scripts/stamp-assets.mjs --check",
    "pack:site": "node scripts/pack-site.mjs",
    "images": "node scripts/build-images.mjs",
    "og": "node scripts/build-og.mjs",
    "check:social": "node scripts/check-social.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:smoke": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run validate:html && npm run check:i18n && npm run check:social && npm run stamp:check && npm run test:unit && npm run test:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    }
  }
}
